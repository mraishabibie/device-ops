<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        android:src="@android:drawable/stat_sys_phone_call"
        android:tint="#1E3A8A" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DeviceOps Agent"
        android:textColor="#111827"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Status: UNPAIRED"
        android:textColor="#374151"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnScanQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#2563EB"
        android:text="Scan QR Code"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="— OR —"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etPairingToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Enter 16-character QR token code"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="#111827"
        android:background="@android:drawable/editbox_background_normal"
        android:padding="12dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#2563EB"
        android:text="Pair &amp; Register Device"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBatteryOptimizationWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#FEF2F2"
        android:padding="16dp"
        android:text="Warning: Battery optimization is active..."
        android:textColor="#991B1B"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRequestIgnoreBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#DC2626"
        android:text="Ignore Battery Optimization"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Debug Console Layout -->
    <LinearLayout
        android:id="@+id/layoutDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="#F9FAFB"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEBUG CONSOLE"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#E5E7EB" />

        <TextView
            android:id="@+id/tvDebugPairStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pair Status: -"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDebugDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Device ID: -"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDebugApiUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="API URL: -"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDebugLastSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last Sync Time: -"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDebugQueueCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pending Queue Count: -"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDebugLastResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last Upload Result: -"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#10B981"
            android:text="Sync Now"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    </LinearLayout>

</ScrollView>
