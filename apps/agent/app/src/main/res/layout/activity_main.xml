<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        android:src="@android:drawable/stat_sys_phone_call"
        android:tint="#1E3A8A" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="DeviceOps Agent"
        android:textColor="#111827"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Status: UNPAIRED"
        android:textColor="#374151"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etPairingToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Enter 16-character QR token code"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="#111827"
        android:background="@android:drawable/editbox_background_normal"
        android:padding="12dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#2563EB"
        android:text="Pair &amp; Register Device"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBatteryOptimizationWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#FEF2F2"
        android:padding="16dp"
        android:text="Warning: Battery optimization is active..."
        android:textColor="#991B1B"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRequestIgnoreBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#DC2626"
        android:text="Ignore Battery Optimization"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
